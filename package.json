{
  "name": "space-attack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "test": "vitest run && node --test server/*.test.mjs",
    "typecheck": "tsc -b",
    "start": "node server/index.mjs",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate-postgres.mjs",
    "test:postgres": "node --env-file-if-exists=.env.local --test server/postgres.integration.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.2",
    "@neondatabase/serverless": "^1.2.0",
    "@react-three/fiber": "^9.0.0",
    "@react-three/rapier": "^2.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.3"
  }
}
