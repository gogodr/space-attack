# Local SQLite is used when DATABASE_URL is absent.
# Keep the actual Neon connection string only in .env.local / Vercel environment settings.
DATABASE_URL=
PORT=3001
HOST=127.0.0.1

# Comma-separated exact browser origins allowed to call /api across sites.
CORS_ORIGINS=
# Optional public API origin; leave empty for local and Vercel same-origin builds.
VITE_API_BASE_URL=
